{
  "name": "way-back-watch",
  "author": "Daniel Bally",
  "version": "0.7.1",
  "private": true,
  "keywords": ["pebble-app"],
  "pebble": {
    "displayName": "Way Back",
    "uuid": "2062ace2-4528-4975-95b6-fc2cbf11de0d",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["emery", "gabbro"],
    "watchapp": {"watchface": true},
    "capabilities": ["configurable"],
    "messageKeys": [
      "SETTING_LOOK", "SETTING_DATE", "SETTING_MOTION",
      "SETTING_BG", "SETTING_FRONT", "SETTING_DEPTH", "SETTING_GRID",
      "SETTING_MODE", "SETTING_NIGHT_START", "SETTING_DAY_START",
      "SETTING_NIGHT_BG", "SETTING_NIGHT_FRONT", "SETTING_NIGHT_DEPTH",
      "SETTING_NIGHT_GRID", "SETTING_DECORATION", "SETTING_FONT",
      "SETTING_BACKGROUND", "SETTING_ECHOES", "SETTING_ECHO_REVERSE"
    ],
    "resources": {"media": [
      {"type": "font", "name": "CORMORANT_54", "file": "fonts/CormorantGaramond-600.ttf", "characterRegex": "[:0-9]"},
      {"type": "font", "name": "BODONI_54", "file": "fonts/BodoniModa-700.ttf", "characterRegex": "[:0-9]"},
      {"type": "font", "name": "SPACE_GROTESK_54", "file": "fonts/SpaceGrotesk-600.ttf", "characterRegex": "[:0-9]"},
      {"type": "font", "name": "GRIDCORE_BOOK_54", "file": "fonts/GridcoreBook-700.ttf", "characterRegex": "[:0-9]"}
    ]}
  },
  "dependencies": {"@rebble/clay": "1.1.0"}
}
